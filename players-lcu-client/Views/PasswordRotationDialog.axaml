<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="players_lcu_client.Views.PasswordRotationDialog"
        Width="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Rotate relay password">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock Text="Rotate relay password?" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="This will change the relay password and stop every other client from delivering data until it is updated."
                   TextWrapping="Wrap" />
        <TextBlock Text="Copy the new password to every Player LCU client immediately after rotation."
                   Opacity="0.75" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Rotate password" Click="Rotate_Click" />
        </StackPanel>
    </StackPanel>
</Window>
