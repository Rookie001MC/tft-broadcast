{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tft-broadcast.local/contracts/player-relay/v1/handshake.schema.json",
  "title": "TFT Player Relay v1 handshake response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "serverId", "eventId", "maxPayloadBytes"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "serverId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "maxPayloadBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    }
  }
}
